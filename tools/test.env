# Credenciales EXCLUSIVAS del entorno de pruebas con Docker + OWASP ZAP.
# Este archivo se versiona a proposito: son usuarios desechables que se crean
# en un MySQL efimero (docker compose down -v los borra).
# NO usar estos valores en ningun otro entorno.
#
# OJO con el dominio: NO usar .local / .test / .invalid / .example / .onion.
# Son dominios de uso especial y email-validator (validacion de EmailStr en
# pydantic) los rechaza, por lo que el login devuelva 422 en vez de 401.

ALLOCAT_ADMIN_EMAIL=admin@example.com
ALLOCAT_ADMIN_PASSWORD=ZapAllocat2026!
ALLOCAT_REQUESTER_EMAIL=requester@example.com
ALLOCAT_REQUESTER_PASSWORD=ZapAllocat2026!
ALLOCAT_AUDITOR_EMAIL=auditor@example.com
ALLOCAT_AUDITOR_PASSWORD=ZapAllocat2026!

ZAP_API_KEY=zap-allocat-local
